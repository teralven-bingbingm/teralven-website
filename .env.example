# Copy to .env.local (never commit .env.local). Where the two forms go: the pitch form on /pitch
# and the message form on /contact (lib/inbox.ts). Set ONE of the two options below; if both
# are set, Resend is used. Without either, the forms answer "not connected yet" and point
# visitors to the email addresses.

# ---- Option 1: email through Resend (recommended) -----------------------------------------
# A key that can send (Resend -> API Keys). The sender must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Teralven Website <website@teralvencapital.com>"
# Who receives messages from /contact. Several recipients: separate with commas.
CONTACT_TO_EMAIL=hello@teralvencapital.com
# Who receives pitches from /pitch. Leave empty to send them to CONTACT_TO_EMAIL as well.
PITCH_TO_EMAIL=

# ---- Option 2: a webhook ------------------------------------------------------------------
# Any endpoint that accepts a JSON POST: a Google Apps Script web app (ends in /exec), a Power
# Automate "When an HTTP request is received" flow, a Zapier or Make webhook… Each submission
# carries type "pitch" or "message", so one sheet can take both.
CONTACT_WEBHOOK_URL=
# Sent along with every submission, so the receiver can tell it is ours: openssl rand -hex 24
CONTACT_SECRET=
